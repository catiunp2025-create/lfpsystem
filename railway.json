{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && cd backend && npx prisma generate && pnpm run build"
  },
  "deploy": {
    "preDeployCommand": "npx prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "startCommand": "node backend/dist/main",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
